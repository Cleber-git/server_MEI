# Database
DB_NAME=server_mei
DB_USER=server_mei
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# JWT keys are kid:secret pairs; use >=32 random bytes per secret and rotate kid.
JWT_ISSUER=https://server-mei.example
JWT_AUDIENCE=caltech-mei-android
JWT_SIGNING_KEYS=key-2026-01:
JWT_ACTIVE_KID=key-2026-01
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Fiscal is fail-closed. Production is never enabled by these flags alone.
FISCAL_FEATURE_ENABLED=false
FISCAL_PRODUCTION_ENABLED=false
FISCAL_JOB_MAX_ATTEMPTS=8
FISCAL_MAX_UPLOAD_BYTES=65536
# Cofre (F4): kid:base64(32 bytes)[,kid:base64…] e o kid ativo. Valores só no Render.
FISCAL_VAULT_MASTER_KEY=
FISCAL_VAULT_ACTIVE_KEY_ID=
# Documentos (F7): unavailable (padrão, nunca transmite) ou fake (só backend local).
FISCAL_PROVIDER=unavailable
FISCAL_WORKER_ENABLED=true
FISCAL_WORKER_POLL_SECONDS=2
# Acesso principal compartilhado por /cpt_recursos e /fornecedores
# Defina valores reais só no Render/.env local; nunca versione a senha.
PRIMARY_ADMIN_NAME=
PRIMARY_ADMIN_LOGIN=
PRIMARY_ADMIN_PASSWORD=
