# Database
DB_NAME=server_mei
DB_USER=server_mei
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# JWT keys are kid:secret pairs; use >=32 random bytes per secret and rotate kid.
JWT_ISSUER=https://server-mei.example
JWT_AUDIENCE=caltech-mei-android
JWT_SIGNING_KEYS=key-2026-01:
JWT_ACTIVE_KID=key-2026-01
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Fiscal is fail-closed. Production is never enabled by these flags alone.
FISCAL_FEATURE_ENABLED=false
FISCAL_PRODUCTION_ENABLED=false
FISCAL_QUEUE_NAME=fiscal-jobs
FISCAL_JOB_MAX_ATTEMPTS=8
FISCAL_RECONCILIATION_INTERVAL=300
FISCAL_ARTIFACT_BUCKET=
FISCAL_ARTIFACT_ROOT=
FISCAL_SIGNED_URL_TTL_SECONDS=120
FISCAL_MAX_UPLOAD_BYTES=5242880
VAULT_PROVIDER=disabled
KMS_KEY_REFERENCE=
# Fernet key for the single-node encrypted vault; supply through the deploy secret store.
FISCAL_LOCAL_VAULT_KEY=
FISCAL_LOCAL_VAULT_ROOT=fiscal-vault
# Acesso principal compartilhado por /cpt_recursos e /fornecedores
PRIMARY_ADMIN_NAME=Cleber Dev
PRIMARY_ADMIN_LOGIN=Cleber Dev
PRIMARY_ADMIN_PASSWORD=02032002
